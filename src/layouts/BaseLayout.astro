---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ronaldo Santos — Backend, Arquitetura de Software & AI Engineering',
  description = 'Engenheiro backend sênior com foco em arquitetura de software, sistemas em produção e AI Engineering.',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ronaldo Santos',
  jobTitle: 'Senior Backend Engineer',
  description: 'Engenheiro de software sênior no Brasil, com atuação remota em backend, arquitetura de software e AI Engineering.',
  email: 'mailto:ronaldo.nasa@gmail.com',
  homeLocation: { '@type': 'Country', name: 'Brasil' },
  sameAs: [
    'https://github.com/kenowlee/',
    'https://www.linkedin.com/in/ronaldo-ns/',
  ],
  knowsAbout: [
    'Backend Engineering',
    'Software Architecture',
    'AI Engineering',
    'Large Language Models',
    'Agentic Systems',
    'Model Context Protocol',
    'Retrieval-Augmented Generation',
    'Evals',
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b10" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
